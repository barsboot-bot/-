// mr_cassette_dance.rvmat — СГЕНЕРИРИРОВАНО tools/make_rvmat.py, не править руками.
// Материал модели носителя мода MusicRadio (MusicRadio).
// Ссылки на .paa — по пути внутри PBO MusicRadioCore, поэтому имя мода на сервере
// может быть любым, а пути остаются валидными.
//
// PNG-исходники:      Models/tex_src/mr_cassette_dance_*.png
// Конвертация:        TexView 2 -> Save As -> PaC (DirectX)
//                     _co = DXT1, _nohq = DXT5, _smdi = DXT1, mipmaps ВКЛ.

ambient[] = {1.0, 1.0, 1.0, 1.0};
diffuse[] = {1.0, 1.0, 1.0, 1.0};
forcedDiffuse[] = {0.0, 0.0, 0.0, 0.0};
emmisive[] = {0.0, 0.0, 0.0, 0.0};
specular[] = {0.22, 0.22, 0.22, 1.0};
specularPower = 34.0;

PixelShaderID = "NormalMapSpecularMap";
VertexShaderID = "NormalMap";

class Stage0
{
	texture = "MusicRadioCore\data\tex\mr_cassette_dance_nohq.paa";
	uvSource = "tex";
	class uvTransform
	{
		aside[] = {1.0, 0.0, 0.0};
		up[] = {0.0, 1.0, 0.0};
		dir[] = {0.0, 0.0, 0.0};
		pos[] = {0.0, 0.0, 0.0};
	};
};
