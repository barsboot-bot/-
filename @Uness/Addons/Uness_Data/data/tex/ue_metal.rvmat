// ue_metal.rvmat — СГЕНЕРИРИРОВАНО tools/make_rvmat.py, не править руками.
// Материал модели носителя мода «унесённые» (Uness).
// Ссылки на .paa — по пути внутри PBO Uness_Data, поэтому имя мода на сервере
// может быть любым, а пути остаются валидными.
//
// PNG-исходники:      Models/tex_src/ue_metal_*.png
// Конвертация:        TexView 2 -> Save As -> PaC (DirectX)
//                     _co = DXT1, _nohq = DXT5, _smdi = DXT1, mipmaps ВКЛ.

ambient[] = {1.0, 1.0, 1.0, 1.0};
diffuse[] = {1.0, 1.0, 1.0, 1.0};
forcedDiffuse[] = {0.0, 0.0, 0.0, 0.0};
emmisive[] = {0.0, 0.0, 0.0, 0.0};
specular[] = {0.85, 0.85, 0.85, 1.0};
specularPower = 62.0;

PixelShaderID = "NormalMapSpecularMap";
VertexShaderID = "NormalMap";

class Stage0
{
	texture = "Uness_Data\data\tex\ue_metal_nohq.paa";
	uvSource = "tex";
	class uvTransform
	{
		aside[] = {1.0, 0.0, 0.0};
		up[] = {0.0, 1.0, 0.0};
		dir[] = {0.0, 0.0, 0.0};
		pos[] = {0.0, 0.0, 0.0};
	};
};
class Stage1
{
	texture = "Uness_Data\data\tex\ue_metal_co.paa";
	uvSource = "tex";
	class uvTransform
	{
		aside[] = {1.0, 0.0, 0.0};
		up[] = {0.0, 1.0, 0.0};
		dir[] = {0.0, 0.0, 0.0};
		pos[] = {0.0, 0.0, 0.0};
	};
};
class Stage2
{
	texture = "#(argb,8,8,3)color(0.0,0.0,0.0,0.0)";
	uvSource = "tex";
};
class Stage3
{
	texture = "#(argb,8,8,3)color(1.0,1.0,1.0,1.0)";
	uvSource = "tex";
};
class Stage4
{
	texture = "Uness_Data\data\tex\ue_metal_smdi.paa";
	uvSource = "tex";
	class uvTransform
	{
		aside[] = {1.0, 0.0, 0.0};
		up[] = {0.0, 1.0, 0.0};
		dir[] = {0.0, 0.0, 0.0};
		pos[] = {0.0, 0.0, 0.0};
	};
};
