; ============================================================
;  UEAudioBridge.def — список экспортов аудио-прослойки
;  (используется build_msvc.bat, чтобы не терять WINAPI-имена)
; ============================================================
LIBRARY UEAudioBridge
EXPORTS
    UE_Initialize
    UE_Shutdown
    UE_GetVersion
    UE_GetLastError
    UE_PlayFile
    UE_PlayStream
    UE_Stop
    UE_SetVolume
    UE_SetPosition
    UE_Pause
    UE_GetState
    UE_IsStreamConnected
    UE_SetListenerPosition
    UE_SelfTest
